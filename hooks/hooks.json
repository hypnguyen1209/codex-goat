{
  "description": "codex-goat lifecycle hooks: rehydrate workflow state, attach entry contracts, record session memory. Never block.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/goat-hook.mjs\"",
            "statusMessage": "codex-goat: loading workflow state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/goat-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/goat-hook.mjs\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
